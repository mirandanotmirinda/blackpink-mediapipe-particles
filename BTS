                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>Customize Records & Audio</span>
                </button>
            </div>
        </div>

        <!-- Disc & Audio Customizer Panel -->
        <div id="editor-panel" class="absolute top-20 right-5 z-20 glass-panel p-5 rounded-3xl w-80 pointer-events-auto hidden transition-all duration-300 shadow-2xl border-indigo-500/30 max-h-[80vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-white/10">
                <h3 class="text-sm font-bold flex items-center gap-2 text-indigo-300">
                    <i class="fa-solid fa-palette"></i>
                    <span>Customize Selected Record</span>
                </h3>
                <button id="close-editor-btn" class="text-slate-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark"></i>
