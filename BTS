        </div>

        <!-- Selected Record Info Panel -->
        <div id="disc-info-panel" class="self-center glass-panel p-5 rounded-3xl text-center max-w-sm w-full transition-all duration-500 transform translate-y-10 opacity-0 pointer-events-auto shadow-2xl border-indigo-500/30">
            <span id="disc-badge" class="px-3 py-1 bg-indigo-500/20 text-indigo-400 text-xs font-semibold rounded-full border border-indigo-500/30">Record #1</span>
