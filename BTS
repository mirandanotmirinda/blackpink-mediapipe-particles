                    <i class="fa-solid fa-rotate-right text-indigo-400"></i>
                    <span>Index Circle: Drop Needle & Play</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <i class="fa-solid fa-hand-back-fist text-rose-400"></i>
