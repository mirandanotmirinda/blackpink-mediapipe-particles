            </div>

            <div class="space-y-4 text-xs">
                <!-- Select Vinyl Disc to Edit -->
                <div>
                    <label class="block text-slate-300 mb-1 font-medium">Select Record:</label>
                    <select id="edit-disc-select" class="w-full bg-slate-800 text-slate-200 border border-slate-700 rounded-lg p-2 focus:outline-none">
                        <!-- JS Dynamically populated -->
                    </select>
                </div>

                <!-- Dedicated Audio Upload for Selected Record -->
                <div class="bg-indigo-950/40 p-3 rounded-2xl border border-indigo-500/30">
                    <label class="block text-indigo-300 mb-1.5 font-semibold flex items-center justify-between">
                        <span><i class="fa-solid fa-file-audio mr-1"></i> Audio Track:</span>
                        <span id="audio-file-status" class="text-[10px] text-slate-400 truncate max-w-[120px]">Default Synth</span>
