                <!-- Custom Texture Uploads -->
                <div>
                    <label class="block text-slate-300 mb-1.5 font-medium">Center Label Image:</label>
                    <label class="block w-full border border-dashed border-slate-600 hover:border-indigo-400 bg-slate-800/40 rounded-xl p-2.5 text-center cursor-pointer transition">
