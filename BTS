                    <i class="fa-solid fa-compact-disc animate-spin" style="animation-duration: 8s;"></i>
                </div>
                <div>
                    <h1 class="text-sm font-bold tracking-wide glow-text">3D Gesture Turntable</h1>
                    <p id="gesture-status" class="text-xs text-indigo-300 font-medium">Initializing Gesture Tracking...</p>
                </div>
            </div>

            <!-- Top Right Bar -->
            <div class="glass-panel p-2.5 rounded-2xl flex items-center gap-2 pointer-events-auto flex-wrap">
                <!-- Background Select -->
                <div class="flex items-center gap-2 border-r border-white/10 pr-2.5">
                    <span class="text-xs text-slate-300 font-medium hidden sm:inline">BG:</span>
                    <select id="bg-select" class="bg-slate-800/90 text-xs text-slate-200 border border-slate-700 rounded-lg px-2 py-1.5 focus:outline-none cursor-pointer">
                        <option value="webcam">🎥 Live Webcam</option>
                        <option value="black">⬛ Black</option>
                        <option value="white">⬜ White</option>
                        <option value="color">🎨 Custom Color</option>
