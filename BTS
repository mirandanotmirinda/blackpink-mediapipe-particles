                </div>
            </div>
            <div class="w-px h-7 bg-white/10"></div>
            <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center font-bold text-[11px]">4</span>
