                <div class="flex justify-between items-center bg-slate-800/50 p-2.5 rounded-xl border border-white/5">
                    <span class="text-slate-300 font-medium">Center Label Color:</span>
                    <input type="color" id="edit-disc-label-color" value="#ffffff" class="w-8 h-8 rounded border-0 bg-transparent cursor-pointer">
