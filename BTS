                </div>
                <div>
                    <label class="block text-slate-300 mb-1 font-medium">Artist / Subtitle:</label>
                    <input type="text" id="edit-disc-artist" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-white focus:border-indigo-500 focus:outline-none">
