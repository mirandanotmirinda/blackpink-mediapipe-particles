                    <label class="block w-full bg-indigo-600 hover:bg-indigo-500 text-white text-center font-semibold py-2 rounded-xl cursor-pointer transition shadow">
                        <i class="fa-solid fa-upload mr-1"></i> Upload Audio for Record
