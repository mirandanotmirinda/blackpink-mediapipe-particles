<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MediaPipe Hand Gesture 3D Vinyl Player</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Three.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    
    <!-- MediaPipe Hands & Camera Utils CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>

    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #050505;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        #webcam-video {
            position: absolute;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            transform: translate(-50%, -50%) scaleX(-1);
            object-fit: cover;
            z-index: 1;
            opacity: 0.65;
            filter: brightness(0.85) contrast(1.1);
            transition: filter 0.8s ease, opacity 0.8s ease;
        }

        #custom-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            background-color: #050505;
            background-size: cover;
            background-position: center;
            transition: background 0.4s ease, opacity 0.8s ease, filter 0.8s ease;
        }

        /* Ambient Dim Overlay when playing */
        #dim-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            background: rgba(0, 0, 0, 0.75);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.8s ease;
        }

        #three-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 2;
            pointer-events: none;
        }

        #gesture-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 3;
            pointer-events: none;
            transform: scaleX(-1);
        }

        .glow-text {
            text-shadow: 0 0 10px rgba(99, 102, 241, 0.8), 0 0 20px rgba(168, 85, 247, 0.5);
        }
        
        .glass-panel {
            background: rgba(15, 23, 42, 0.82);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }
    </style>
</head>
<body class="relative text-white select-none">

    <!-- Webcam Background Video -->
    <video id="webcam-video" autoplay playsinline muted></video>
    
    <!-- Custom/Solid Background Container -->
    <div id="custom-bg" class="hidden"></div>

    <!-- Ambient Dimming Layer -->
    <div id="dim-overlay"></div>

    <!-- 3D Scene Canvas -->
    <canvas id="three-canvas"></canvas>

    <!-- Gesture Tracking Canvas -->
    <canvas id="gesture-canvas"></canvas>

    <!-- UI Overlay -->
    <div class="absolute inset-0 z-10 flex flex-col justify-between p-5 pointer-events-none">
        
        <!-- Top Control Bar -->
        <div class="flex justify-between items-start w-full gap-4">
            <!-- Status Card -->
            <div class="glass-panel p-3.5 rounded-2xl flex items-center gap-3 shadow-2xl pointer-events-auto max-w-sm">
