<!-- Logic Script -->
<script>
    /**
     * Global Configuration & Variables
     */
    const TOTAL_DISCS = 7;
    const RING_RADIUS = 4.2; 
    const HIGH_Y = 1.8;
    let scene, camera, renderer;
    let discGroup, turntableGroup, tonearmGroup, coverGroup;
    let whiteSpotlight, fillLight;
    const discs = [];
    let selectedDiscIndex = -1;
    let isPlaying = false;

    // Interaction State
    let targetRingRotation = 0;
    let currentRingRotation = 0;
    let lastHandX = null;
    let lastPinchTime = 0;
    let indexFingerHistory = [];

    // Turntable & Tonearm Animation Parameters
    let turntableTargetY = -6.0;
    let turntableCurrentY = -6.0;
    let tonearmTargetAngle = 0;
    let tonearmCurrentAngle = 0;

    // Audio Manager with individual track storage per record
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const discDataList = Array.from({ length: TOTAL_DISCS }, (_, i) => ({
        id: i,
        title: `Vinyl Track #${i + 1}`,
        artist: `Artist Spectrum ${i + 1}`,
        bodyColor: ['#ef4444', '#d946ef', '#111115', '#06b6d4', '#f59e0b', '#8b5cf6', '#10b981'][i],
        labelColor: ['#ffffff', '#fef08a', '#ef4444', '#ffffff', '#1e293b', '#ec4899', '#f0fdf4'][i],
        centerImg: null,
        outerImg: null,
        audioUrl: null,
        audioElement: null
    }));

    /**
     * 1. Three.js Scene Setup & Black Turntable Creation
     */
    function initThreeJS() {
        const canvas = document.getElementById('three-canvas');
        scene = new THREE.Scene();

        camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 2.8, 9);
        camera.lookAt(0, 0.5, 0);

        renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;

        // Ambient & Scene Lights
        fillLight = new THREE.AmbientLight(0xffffff, 1.4);
        scene.add(fillLight);

        const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
        dirLight.position.set(6, 12, 8);
        scene.add(dirLight);

        // White Fluorescent Spotlight targeting the spinning disc on the platter
        whiteSpotlight = new THREE.SpotLight(0xffffff, 0); // Intensity dynamically changes when playing
        whiteSpotlight.position.set(-0.6, 6.5, 2.0);
        whiteSpotlight.target.position.set(-0.6, 0.2, 1.2);
        whiteSpotlight.angle = Math.PI / 4.5;
        whiteSpotlight.penumbra = 0.45;
        whiteSpotlight.decay = 1.2;
        scene.add(whiteSpotlight);
        scene.add(whiteSpotlight.target);

        // Build Black Turntable
        createHighEndTurntable();

        // Discs Container
        discGroup = new THREE.Group();
        scene.add(discGroup);

        // Generate 7 Custom Vinyl Discs
        for (let i = 0; i < TOTAL_DISCS; i++) {
            const discMesh = createCustomVinylMesh(i);
            discMesh.userData = { id: i };
            discs.push(discMesh);
            discGroup.add(discMesh);
        }

        updateDiscsTransform(true);
        window.addEventListener('resize', onWindowResize);
    }

    /**
     * Build Black High-End Turntable (Black Needle & Black Platter)
     */
    function createHighEndTurntable() {
        turntableGroup = new THREE.Group();
        turntableGroup.position.set(0, turntableCurrentY, 1.2);
        turntableGroup.rotation.x = Math.PI * 0.1;

        // 1. Sleek Base Body
        const baseGeo = new THREE.BoxGeometry(4.6, 0.38, 3.8);
        const baseMat = new THREE.MeshStandardMaterial({
            color: 0x111827,
            roughness: 0.15,
            metalness: 0.3
        });
        const base = new THREE.Mesh(baseGeo, baseMat);
        base.position.y = -0.19;
        turntableGroup.add(base);

        // Control Knob & LED Status Light
        const knobGeo = new THREE.CylinderGeometry(0.14, 0.14, 0.16, 32);
        const knobMat = new THREE.MeshStandardMaterial({ color: 0x334155, roughness: 0.2, metalness: 0.8 });
        const knob = new THREE.Mesh(knobGeo, knobMat);
        knob.position.set(1.9, 0.08, 1.5);
        turntableGroup.add(knob);

        const ledGeo = new THREE.SphereGeometry(0.04, 16, 16);
        const ledMat = new THREE.MeshBasicMaterial({ color: 0x22c55e });
        const led = new THREE.Mesh(ledGeo, ledMat);
        led.position.set(1.6, 0.05, 1.5);
        turntableGroup.add(led);

        // 2. Pure Black Platter (黑色放唱片的唱片盤)
        const platterGeo = new THREE.CylinderGeometry(1.4, 1.4, 0.08, 64);
        const platterMat = new THREE.MeshStandardMaterial({
            color: 0x050505, // Deep Black
            roughness: 0.4,
            metalness: 0.1
        });
        const platter = new THREE.Mesh(platterGeo, platterMat);
        platter.position.set(-0.6, 0.04, 0);
        turntableGroup.add(platter);

        // Fluorescent Accent Ring Under Platter
        const glowRingGeo = new THREE.CylinderGeometry(1.43, 1.43, 0.03, 64);
        const glowRingMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
        const glowRing = new THREE.Mesh(glowRingGeo, glowRingMat);
        glowRing.position.set(-0.6, 0.01, 0);
        turntableGroup.add(glowRing);

        // Center Spindle Pin
        const spindleGeo = new THREE.CylinderGeometry(0.035, 0.035, 0.28, 16);
        const spindleMat = new THREE.MeshStandardMaterial({ metalness: 0.95, roughness: 0.05, color: 0xd1d5db });
        const spindle = new THREE.Mesh(spindleGeo, spindleMat);
        spindle.position.set(-0.6, 0.14, 0);
        turntableGroup.add(spindle);

        // 3. Transparent Acrylic Dust Cover
        coverGroup = new THREE.Group();
        coverGroup.position.set(0, 0, -1.8);
        coverGroup.rotation.x = -Math.PI * 0.38;

        const coverGeo = new THREE.BoxGeometry(4.6, 0.06, 3.6);
        const coverMat = new THREE.MeshPhysicalMaterial({
            color: 0xffffff,
            transparent: true,
            opacity: 0.22,
            roughness: 0.05,
            transmission: 0.95,
            ior: 1.5
        });
        const cover = new THREE.Mesh(coverGeo, coverMat);
        cover.position.set(0, 0, 1.8);
        coverGroup.add(cover);
        turntableGroup.add(coverGroup);

        // 4. Black Tonearm & Needle Assembly (黑色落針/唱針組)
        tonearmGroup = new THREE.Group();
        tonearmGroup.position.set(1.35, 0.08, -0.6);

        const basePivotGeo = new THREE.CylinderGeometry(0.2, 0.22, 0.22, 32);
        const blackMetalMat = new THREE.MeshStandardMaterial({ color: 0x0a0a0c, metalness: 0.85, roughness: 0.2 });
        const pivot = new THREE.Mesh(basePivotGeo, blackMetalMat);
        tonearmGroup.add(pivot);

        // Counterweight & Arm Bar (Black)
        const counterWeightGeo = new THREE.CylinderGeometry(0.1, 0.1, 0.2, 32);
        const counterWeight = new THREE.Mesh(counterWeightGeo, blackMetalMat);
        counterWeight.rotation.x = Math.PI / 2;
        counterWeight.position.set(0.15, 0.2, -0.2);
        tonearmGroup.add(counterWeight);

        const armGeo = new THREE.CylinderGeometry(0.025, 0.025, 1.75, 16);
        const arm = new THREE.Mesh(armGeo, blackMetalMat);
        arm.rotation.z = Math.PI / 2;
        arm.rotation.y = -Math.PI / 5;
        arm.position.set(-0.7, 0.18, 0.35);
        tonearmGroup.add(arm);

        // Cartridge & Black Needle Head (黑色唱針)
        const cartridgeGeo = new THREE.BoxGeometry(0.08, 0.09, 0.22);
        const cartridgeMat = new THREE.MeshStandardMaterial({ color: 0x020202, metalness: 0.9, roughness: 0.1 });
        const cartridge = new THREE.Mesh(cartridgeGeo, cartridgeMat);
        cartridge.position.set(-1.45, 0.12, 0.72);
        cartridge.rotation.y = Math.PI * 0.22;

        // Needle Stylus Pin
        const needlePinGeo = new THREE.CylinderGeometry(0.008, 0.002, 0.08, 16);
        const needlePinMat = new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.95, roughness: 0.05 });
        const needlePin = new THREE.Mesh(needlePinGeo, needlePinMat);
        needlePin.position.set(0, -0.05, 0.08);
        cartridge.add(needlePin);

        tonearmGroup.add(cartridge);
        turntableGroup.add(tonearmGroup);
        scene.add(turntableGroup);
    }

    /**
     * Canvas Generated Vinyl Disc Texture Mesh
     */
    function createCustomVinylMesh(index) {
        const group = new THREE.Group();
        const discGeo = new THREE.CylinderGeometry(1.25, 1.25, 0.03, 64);
        
        const discMat = new THREE.MeshStandardMaterial({
            roughness: 0.25,
            metalness: 0.45,
        });

        const discMesh = new THREE.Mesh(discGeo, discMat);
        group.add(discMesh);

        // Highlighting Outer Ring
        const ringGeo = new THREE.RingGeometry(1.28, 1.33, 32);
        const ringMat = new THREE.MeshBasicMaterial({
            color: 0x6366f1,
            side: THREE.DoubleSide,
            transparent: true,
            opacity: 0.2
        });
        const glowRing = new THREE.Mesh(ringGeo, ringMat);
        glowRing.rotation.x = Math.PI / 2;
        glowRing.name = "glowRing";
        group.add(glowRing);

        updateDiscTexture(index, discMesh);
        return group;
    }

    /**
     * 2D Canvas Disc Texture Generator
     */
    function updateDiscTexture(index, discMesh) {
        const data = discDataList[index];
        const canvas = document.createElement('canvas');
        canvas.width = 1024;
        canvas.height = 1024;
        const ctx = canvas.getContext('2d');

        // 1. Outer Disc Background or Pattern Image
        if (data.outerImg) {
            ctx.drawImage(data.outerImg, 0, 0, 1024, 1024);
        } else {
            ctx.fillStyle = data.bodyColor;
            ctx.fillRect(0, 0, 1024, 1024);

            // Vinyl Grooves
            ctx.strokeStyle = 'rgba(0, 0, 0, 0.35)';
            ctx.lineWidth = 2.5;
            for (let r = 180; r < 480; r += 7) {
                ctx.beginPath();
                ctx.arc(512, 512, r, 0, Math.PI * 2);
                ctx.stroke();
            }
        }

        // 2. Center Label
        ctx.save();
        ctx.beginPath();
        ctx.arc(512, 512, 160, 0, Math.PI * 2);
        ctx.clip();

        if (data.centerImg) {
            ctx.drawImage(data.centerImg, 352, 352, 320, 320);
        } else {
            ctx.fillStyle = data.labelColor;
            ctx.fillRect(352, 352, 320, 320);
            
            ctx.fillStyle = '#0f172a';
            ctx.font = 'bold 36px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(data.title, 512, 470);
            ctx.font = '22px sans-serif';
            ctx.fillText(data.artist, 512, 560);
        }
        ctx.restore();

        // 3. Center Hole
        ctx.fillStyle = '#000000';
        ctx.beginPath();
        ctx.arc(512, 512, 22, 0, Math.PI * 2);
        ctx.fill();

        const texture = new THREE.CanvasTexture(canvas);
        discMesh.material.map = texture;
        discMesh.material.needsUpdate = true;
    }

    function onWindowResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);

        const gCanvas = document.getElementById('gesture-canvas');
        gCanvas.width = window.innerWidth;
        gCanvas.height = window.innerHeight;
    }

    /**
     * 2. MediaPipe Hands Tracking
     */
    function initMediaPipe() {
        const videoElement = document.getElementById('webcam-video');
        const gestureCanvas = document.getElementById('gesture-canvas');
        const ctx = gestureCanvas.getContext('2d');

        gestureCanvas.width = window.innerWidth;
        gestureCanvas.height = window.innerHeight;

        const hands = new Hands({
            locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
        });

        hands.setOptions({
            maxNumHands: 1,
            modelComplexity: 1,
            minDetectionConfidence: 0.65,
            minTrackingConfidence: 0.65
        });

        hands.onResults((results) => {
            ctx.clearRect(0, 0, gestureCanvas.width, gestureCanvas.height);

            if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
                const landmarks = results.multiHandLandmarks[0];
                drawHandOverlay(ctx, landmarks);
                processHandGestures(landmarks);
            } else {
                document.getElementById('gesture-status').innerText = 'Waiting for hand gestures...';
                lastHandX = null;
            }
        });

        const cameraUtils = new Camera(videoElement, {
            onFrame: async () => {
                await hands.send({ image: videoElement });
            },
            width: 1280,
            height: 720
        });
        cameraUtils.start();
    }

    /**
     * Hand Gesture Detection Engine
     */
    function processHandGestures(landmarks) {
        const statusEl = document.getElementById('gesture-status');
        const indexTip = landmarks[8];
        const indexMcp = landmarks[5];
        const thumbTip = landmarks[4];

        // 1. Fist Gesture -> Reset & Hide
        const isFist = isFingerBent(landmarks, 8, 5) &&
                       isFingerBent(landmarks, 12, 9) &&
                       isFingerBent(landmarks, 16, 13) &&
                       isFingerBent(landmarks, 20, 17);

        if (isFist) {
            statusEl.innerText = '✊ Fist: Hiding turntable & resetting';
            resetSelection();
            return;
        }

        const pinchDist = dist(indexTip, thumbTip);
        const now = Date.now();

        const isIndexOnly = !isFingerBent(landmarks, 8, 5) &&
                            isFingerBent(landmarks, 12, 9) &&
                            isFingerBent(landmarks, 16, 13) &&
                            isFingerBent(landmarks, 20, 17);

        const isOpenPalm = !isFingerBent(landmarks, 8, 5) &&
                           !isFingerBent(landmarks, 12, 9) &&
                           !isFingerBent(landmarks, 16, 13) &&
                           !isFingerBent(landmarks, 20, 17);

        // Index Tap/Pinch to select disc
        if ((pinchDist < 0.08 || isIndexOnly) && selectedDiscIndex === -1 && (now - lastPinchTime > 1000)) {
            lastPinchTime = now;
            checkDiscSelectionByClick();
            return;
        }

        // Open Palm Pan -> Rotate Discs
        if (isOpenPalm && selectedDiscIndex === -1) {
            statusEl.innerText = '🖐️ Open Palm Pan: Rotate vinyl ring';
            const currentHandX = indexMcp.x;
            if (lastHandX !== null) {
                targetRingRotation += (currentHandX - lastHandX) * 5.5;
            }
            lastHandX = currentHandX;
            return;
        } else if (isOpenPalm && selectedDiscIndex !== -1) {
            statusEl.innerText = '🖐️ Open Palm Pan: Browse background disclist';
            const currentHandX = indexMcp.x;
            if (lastHandX !== null) {
                targetRingRotation += (currentHandX - lastHandX) * 3.5;
            }
            lastHandX = currentHandX;
            return;
        } else {
            lastHandX = null;
        }

        // Index Circle Gesture -> Drop needle and start playing
        if (isIndexOnly && selectedDiscIndex !== -1) {
            detectCircleGesture(indexTip);
            statusEl.innerText = isPlaying ? '🎵 Playing record with white spotlight focused!' : '☝️ Index Circle: Drop needle & start playing';
            return;
        }
    }

    function isFingerBent(landmarks, tipIdx, mcpIdx) {
        return dist(landmarks[tipIdx], landmarks[0]) < dist(landmarks[mcpIdx], landmarks[0]);
    }

    function dist(p1, p2) {
        return Math.hypot(p1.x - p2.x, p1.y - p2.y, (p1.z || 0) - (p2.z || 0));
    }

    /**
     * Circular Trajectory Recognition
     */
    function detectCircleGesture(indexTip) {
        const now = Date.now();
        indexFingerHistory.push({ x: indexTip.x, y: indexTip.y, time: now });
        indexFingerHistory = indexFingerHistory.filter(p => now - p.time < 1000);

        if (indexFingerHistory.length > 12) {
            let totalAngleChange = 0;
            for (let i = 2; i < indexFingerHistory.length; i++) {
                const p1 = indexFingerHistory[i - 2];
                const p2 = indexFingerHistory[i - 1];
                const p3 = indexFingerHistory[i];

                const v1 = { x: p2.x - p1.x, y: p2.y - p1.y };
                const v2 = { x: p3.x - p2.x, y: p3.y - p2.y };

                const angle1 = Math.atan2(v1.y, v1.x);
                const angle2 = Math.atan2(v2.y, v2.x);

                let diff = angle2 - angle1;
                while (diff < -Math.PI) diff += Math.PI * 2;
                while (diff > Math.PI) diff -= Math.PI * 2;

                totalAngleChange += diff;
            }

            if (Math.abs(totalAngleChange) > Math.PI * 2.2) {
                if (!isPlaying && selectedDiscIndex !== -1) {
                    startPlayingDisc(selectedDiscIndex);
                }
                indexFingerHistory = [];
            }
        }
    }

    function checkDiscSelectionByClick() {
        let closestDisc = -1;
        let maxZ = -Infinity;

        discs.forEach((disc, idx) => {
            const worldPos = new THREE.Vector3();
            disc.getWorldPosition(worldPos);

            if (worldPos.z > maxZ) {
                maxZ = worldPos.z;
                closestDisc = idx;
            }
        });

        if (closestDisc !== -1) {
            selectDisc(closestDisc);
        }
    }

    /**
     * Select Disc
     */
    function selectDisc(index) {
        selectedDiscIndex = index;
        isPlaying = false;

        // Raise Turntable
        turntableTargetY = -1.75;
        tonearmTargetAngle = 0;

        const infoPanel = document.getElementById('disc-info-panel');
        const data = discDataList[index];

        document.getElementById('disc-badge').innerText = `Record #${index + 1}`;
        document.getElementById('disc-title').innerText = data.title;
        document.getElementById('disc-artist').innerText = data.artist;

        infoPanel.classList.remove('translate-y-10', 'opacity-0');
        infoPanel.classList.add('translate-y-0', 'opacity-100');

        updateAudioStatusInEditor(index);
    }

    /**
     * Reset Selection
     */
    function resetSelection() {
        selectedDiscIndex = -1;
        isPlaying = false;

        // Hide Turntable & Dim Overlay
        turntableTargetY = -6.0;
        tonearmTargetAngle = 0;

        const infoPanel = document.getElementById('disc-info-panel');
        infoPanel.classList.add('translate-y-10', 'opacity-0');
        infoPanel.classList.remove('translate-y-0', 'opacity-100');

        document.getElementById('dim-overlay').style.opacity = '0';

        stopAudio();
    }

    /**
     * Drop Needle, Focus White Spotlight & Play
     */
    function startPlayingDisc(index) {
        isPlaying = true;
        // Drop Black Needle onto Record
        tonearmTargetAngle = Math.PI * 0.18;

        // Dim background for focused lighting effect
        document.getElementById('dim-overlay').style.opacity = '1';

        const data = discDataList[index];
        if (data.audioElement) {
            data.audioElement.currentTime = 0;
            data.audioElement.play();
        } else {
            playSynthSound(index);
        }
    }

    let currentOscillator = null;

    function playSynthSound(index) {
        if (audioCtx.state === 'suspended') audioCtx.resume();
        if (currentOscillator) try { currentOscillator.stop(); } catch(e){}

        const freqs = [261.63, 293.66, 329.63, 349.23, 392.00, 440.00, 493.88];
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freqs[index % freqs.length], audioCtx.currentTime);

        gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 4);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start();
        currentOscillator = osc;
    }

    function stopAudio() {
        if (currentOscillator) {
            try { currentOscillator.stop(); } catch(e){}
            currentOscillator = null;
        }
        discDataList.forEach(d => {
            if (d.audioElement) {
                d.audioElement.pause();
            }
        });
    }

    /**
     * Draw Hand Overlay Landmarks
     */
    function drawHandOverlay(ctx, landmarks) {
        const w = ctx.canvas.width;
        const h = ctx.canvas.height;
        const connections = [
            [0,1],[1,2],[2,3],[3,4],
            [0,5],[5,6],[6,7],[7,8],
            [5,9],[9,10],[10,11],[11,12],
            [9,13],[13,14],[14,15],[15,16],
            [13,17],[17,18],[18,19],[19,20],[0,17]
        ];

        ctx.strokeStyle = 'rgba(99, 102, 241, 0.6)';
        ctx.lineWidth = 3;

        connections.forEach(([i, j]) => {
            ctx.beginPath();
            ctx.moveTo(landmarks[i].x * w, landmarks[i].y * h);
            ctx.lineTo(landmarks[j].x * w, landmarks[j].y * h);
            ctx.stroke();
        });

        landmarks.forEach((pt, index) => {
            ctx.beginPath();
            ctx.arc(pt.x * w, pt.y * h, index === 8 ? 8 : 4, 0, Math.PI * 2);
            ctx.fillStyle = index === 8 ? '#ec4899' : '#38bdf8';
            ctx.fill();
        });
    }

    /**
     * Real-time 3D Disc Position & Lighting Engine
     */
    function updateDiscsTransform(immediate = false) {
        const time = Date.now() * 0.002;
        currentRingRotation += (targetRingRotation - currentRingRotation) * 0.1;

        // Dynamic Spotlight and Ambient Dimming Control
        if (isPlaying) {
            whiteSpotlight.intensity += (12.0 - whiteSpotlight.intensity) * 0.08;
            fillLight.intensity += (0.4 - fillLight.intensity) * 0.08;
        } else {
            whiteSpotlight.intensity += (0 - whiteSpotlight.intensity) * 0.08;
            fillLight.intensity += (1.4 - fillLight.intensity) * 0.08;
            document.getElementById('dim-overlay').style.opacity = '0';
        }

        if (selectedDiscIndex === -1) {
            // Mode 1: Ring formation in the air
            discs.forEach((disc, i) => {
                const angle = (i / TOTAL_DISCS) * Math.PI * 2 + currentRingRotation;
                const targetX = Math.sin(angle) * RING_RADIUS;
                const targetZ = Math.cos(angle) * RING_RADIUS;
                const targetY = HIGH_Y + Math.sin(time + i) * 0.22;

                if (immediate) {
                    disc.position.set(targetX, targetY, targetZ);
                    disc.rotation.set(0, angle, 0);
                } else {
                    disc.position.x += (targetX - disc.position.x) * 0.1;
                    disc.position.z += (targetZ - disc.position.z) * 0.1;
                    disc.position.y += (targetY - disc.position.y) * 0.1;

                    disc.rotation.x += (Math.PI / 2 - disc.rotation.x) * 0.1;
                    disc.rotation.y += (angle - disc.rotation.y) * 0.1;
                    disc.rotation.z += (0 - disc.rotation.z) * 0.1;
                }

                const ring = disc.getObjectByName("glowRing");
                if (ring) ring.material.opacity = 0.2;
            });
        } else {
            // Mode 2: Disc loaded onto black platter
            const targetDisc = discs[selectedDiscIndex];
            const platterPos = new THREE.Vector3(-0.6, turntableCurrentY + 0.2, 1.2);

            targetDisc.position.x += (platterPos.x - targetDisc.position.x) * 0.12;
            targetDisc.position.y += (platterPos.y - targetDisc.position.y) * 0.12;
            targetDisc.position.z += (platterPos.z - targetDisc.position.z) * 0.12;

            targetDisc.rotation.x += (Math.PI * 0.1 - targetDisc.rotation.x) * 0.12;
            targetDisc.rotation.z += (0 - targetDisc.rotation.z) * 0.12;

            if (isPlaying) {
                targetDisc.rotation.y += 0.06; // Continuous spinning
            } else {
                targetDisc.rotation.y += (0 - targetDisc.rotation.y) * 0.1;
            }

            const activeRing = targetDisc.getObjectByName("glowRing");
            if (activeRing) activeRing.material.opacity = 0.8;

            // Line up unselected discs in background
            let unselectedCount = 0;
            const totalUnselected = TOTAL_DISCS - 1;
            const startX = -3.8;
            const stepX = 7.6 / Math.max(totalUnselected - 1, 1);

            discs.forEach((disc, i) => {
                if (i === selectedDiscIndex) return;

                const lineX = startX + unselectedCount * stepX + currentRingRotation * 1.5;
                const lineY = 2.2 + Math.sin(time + i) * 0.15;
                const lineZ = -2.0;

                disc.position.x += (lineX - disc.position.x) * 0.08;
                disc.position.y += (lineY - disc.position.y) * 0.08;
                disc.position.z += (lineZ - disc.position.z) * 0.08;

                disc.rotation.x += (Math.PI / 2.2 - disc.rotation.x) * 0.08;
                disc.rotation.y += (0 - disc.rotation.y) * 0.08;
                disc.rotation.z += (0 - disc.rotation.z) * 0.08;

                const ring = disc.getObjectByName("glowRing");
                if (ring) ring.material.opacity = 0.1;

                unselectedCount++;
            });
        }
    }

    /**
     * 5. Editor Panel Controls (Per-Disc Audio Uploading Enabled)
     */
    function initEditorControls() {
        const toggleBtn = document.getElementById('toggle-editor-btn');
        const closeBtn = document.getElementById('close-editor-btn');
        const editorPanel = document.getElementById('editor-panel');
        const discSelect = document.getElementById('edit-disc-select');

        // Populate Disc Dropdown
        for (let i = 0; i < TOTAL_DISCS; i++) {
            const opt = document.createElement('option');
            opt.value = i;
            opt.innerText = `Record #${i + 1}`;
            discSelect.appendChild(opt);
        }

        toggleBtn.addEventListener('click', () => {
            editorPanel.classList.toggle('hidden');
            const targetIdx = selectedDiscIndex !== -1 ? selectedDiscIndex : parseInt(discSelect.value);
            discSelect.value = targetIdx;
            loadDiscDataToForm(targetIdx);
        });

        closeBtn.addEventListener('click', () => editorPanel.classList.add('hidden'));

        discSelect.addEventListener('change', (e) => {
            loadDiscDataToForm(parseInt(e.target.value));
        });

        // Load Record Data into Form
        function loadDiscDataToForm(idx) {
            const d = discDataList[idx];
            document.getElementById('edit-disc-title').value = d.title;
            document.getElementById('edit-disc-artist').value = d.artist;
            document.getElementById('edit-disc-body-color').value = d.bodyColor;
            document.getElementById('edit-disc-label-color').value = d.labelColor;
            updateAudioStatusInEditor(idx);
        }

        // Upload Audio for ANY specific record
        document.getElementById('upload-disc-audio').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;

            const idx = parseInt(discSelect.value);
            const url = URL.createObjectURL(file);

            discDataList[idx].audioUrl = url;
            discDataList[idx].audioElement = new Audio(url);
            
            // Auto update title if unedited
            if (discDataList[idx].title.startsWith('Vinyl Track #')) {
                discDataList[idx].title = file.name.replace(/\.[^/.]+$/, "");
                document.getElementById('edit-disc-title').value = discDataList[idx].title;
            }
            discDataList[idx].artist = "Custom Audio Track";

            updateAudioStatusInEditor(idx);
            updateDiscTexture(idx, discs[idx].children[0]);

            if (selectedDiscIndex === idx) selectDisc(idx);
        });

        // Center Image Texture Upload
        document.getElementById('upload-center-image').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const idx = parseInt(discSelect.value);
            const img = new Image();
            img.src = URL.createObjectURL(file);
            img.onload = () => {
                discDataList[idx].centerImg = img;
                document.getElementById('center-img-label-text').innerText = file.name;
            };
        });

        // Outer Image Texture Upload
        document.getElementById('upload-outer-image').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const idx = parseInt(discSelect.value);
            const img = new Image();
            img.src = URL.createObjectURL(file);
            img.onload = () => {
                discDataList[idx].outerImg = img;
                document.getElementById('outer-img-label-text').innerText = file.name;
            };
        });

        // Apply Customizations
        document.getElementById('apply-disc-edit').addEventListener('click', () => {
            const idx = parseInt(discSelect.value);
            const d = discDataList[idx];

            d.title = document.getElementById('edit-disc-title').value;
            d.artist = document.getElementById('edit-disc-artist').value;
            d.bodyColor = document.getElementById('edit-disc-body-color').value;
            d.labelColor = document.getElementById('edit-disc-label-color').value;

            const discMesh = discs[idx].children[0];
            updateDiscTexture(idx, discMesh);

            if (selectedDiscIndex === idx) {
                document.getElementById('disc-title').innerText = d.title;
                document.getElementById('disc-artist').innerText = d.artist;
            }

            editorPanel.classList.add('hidden');
        });
    }

    function updateAudioStatusInEditor(idx) {
        const d = discDataList[idx];
        const statusEl = document.getElementById('audio-file-status');
        if (statusEl) {
            statusEl.innerText = d.audioElement ? "Custom Track Loaded" : "Default Synth";
        }
    }

    /**
     * 6. Background Controls
     */
    function initBackgroundControls() {
        const bgSelect = document.getElementById('bg-select');
        const colorPicker = document.getElementById('bg-color-picker');
        const imageUpload = document.getElementById('bg-image-upload');
        const webcamVideo = document.getElementById('webcam-video');
        const customBg = document.getElementById('custom-bg');

        bgSelect.addEventListener('change', (e) => {
            const mode = e.target.value;
            colorPicker.classList.add('hidden');

            if (mode === 'webcam') {
                webcamVideo.classList.remove('hidden');
                customBg.classList.add('hidden');
            } else if (mode === 'black') {
                webcamVideo.classList.add('hidden');
                customBg.classList.remove('hidden');
                customBg.style.backgroundImage = 'none';
                customBg.style.backgroundColor = '#000000';
            } else if (mode === 'white') {
                webcamVideo.classList.add('hidden');
                customBg.classList.remove('hidden');
                customBg.style.backgroundImage = 'none';
                customBg.style.backgroundColor = '#ffffff';
            } else if (mode === 'color') {
                colorPicker.classList.remove('hidden');
                colorPicker.click();
            } else if (mode === 'image') {
                imageUpload.click();
            }
        });

        colorPicker.addEventListener('input', (e) => {
            webcamVideo.classList.add('hidden');
            customBg.classList.remove('hidden');
            customBg.style.backgroundImage = 'none';
            customBg.style.backgroundColor = e.target.value;
        });

        imageUpload.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const url = URL.createObjectURL(file);
                webcamVideo.classList.add('hidden');
                customBg.classList.remove('hidden');
                customBg.style.backgroundImage = `url(${url})`;
            }
        });
    }

    /**
     * Animation Loop
     */
    window.onload = () => {
        initThreeJS();
        initMediaPipe();
        initEditorControls();
        initBackgroundControls();
        animate();
    };

    function animate() {
        requestAnimationFrame(animate);

        // Turntable Y Position Smooth Interpolation
        turntableCurrentY += (turntableTargetY - turntableCurrentY) * 0.08;
        if (turntableGroup) {
            turntableGroup.position.y = turntableCurrentY;
        }

        // Black Tonearm Rotation Angle Smooth Interpolation
        tonearmCurrentAngle += (tonearmTargetAngle - tonearmCurrentAngle) * 0.08;
        if (tonearmGroup) {
            tonearmGroup.rotation.y = tonearmCurrentAngle;
        }

        updateDiscsTransform();
        renderer.render(scene, camera);
    }
</script>
